# Copy to .env and fill locally. Never commit credentials or the resulting .env.
# docker compose / npm run stack:up read this deployment configuration.
AIVERO_DB_PASSWORD=replace_with_url_safe_database_password
AIVERO_MQ_PASSWORD=replace_with_url_safe_broker_password
AIVERO_PUBLIC_ORIGIN=https://frayune.example.com
AIVERO_OIDC_ISSUER=https://identity.example.com
AIVERO_OIDC_CLIENT_ID=replace_with_registered_oidc_client_id
AIVERO_OIDC_CLIENT_SECRET=replace_with_oidc_client_secret
AIVERO_SESSION_SECRET=replace_with_an_independent_random_secret_at_least_32_characters
# Absolute paths on the host. Use deploy/provider-routes.mock.json and
# deploy/provider-credentials.mock.json for a deployment with no paid model calls.
AIVERO_ROUTES_FILE=/absolute/path/to/provider-routes.json
AIVERO_CREDENTIALS_FILE=/absolute/path/to/provider-credentials.json
# Optional Agent routes; omitted uses deploy/agent-routes.disabled.json (feature unavailable).
# Use deploy/agent-routes.example.json, then pin supported models and workspace endpoints.
# Agent credentials are resolved only by the worker from the same credentials registry.
AIVERO_AGENT_ROUTES_FILE=./deploy/agent-routes.disabled.json
# Exact output origins allowed for cloud artifact downloads, comma-separated.
AIVERO_ARTIFACT_ORIGINS=
# Optional Bearer token for /internal/metrics; empty keeps it disabled.
AIVERO_METRICS_TOKEN=
