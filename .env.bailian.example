# 复制为 .env.bailian.local,在自己的编辑器中填写;不要发送到聊天。
# npm run start:bailian 会加载 .env.bailian.local (Node >= 20.6)。
SWARMUI_PROVIDER=cloud
SWARMUI_CLOUD_VENDOR=aliyun
SWARMUI_CLOUD_MODEL=qwen-image-2.0
# 从百炼控制台复制北京地域接口地址,或替换下面的业务空间 ID。
SWARMUI_CLOUD_BASE_URL=https://YOUR_WORKSPACE_ID.cn-beijing.maas.aliyuncs.com/api/v1
SWARMUI_IMAGE_API_KEY=
SWARMUI_CLOUD_TEXT_MODEL=
SWARMUI_PORT=7802
SWARMUI_IMAGE_TIMEOUT_MIN=20
