# 本地开发环境 API 配置模板。scripts/dev_stack.py 会把它生成到 data/dev/api.env
# (填入本机绝对路径),生成后可直接编辑,不会被覆盖。
# 生产环境配置见 .env.production.example(docker compose / npm run stack:up 使用)。

# 指向 dev_stack 暴露的基础设施端口(55437/6387)。
AIVERO_DB_URL=postgresql+psycopg://aivideo:aivideo_dev@127.0.0.1:55437/aivideo
AIVERO_REDIS_URL=redis://127.0.0.1:6387/0

AIVERO_PRODUCTION_PUBLIC_ORIGIN=https://localhost:8443
AIVERO_PRODUCTION_OIDC_ISSUER=https://localhost:8444
AIVERO_PRODUCTION_OIDC_CLIENT_ID=dev-browser
AIVERO_PRODUCTION_OIDC_CLIENT_SECRET=dev-browser-secret
AIVERO_PRODUCTION_SESSION_SECRET=aivideo-local-dev-session-secret-change-me

# Mock Provider:零付费调用,生成链路完整可用。
AIVERO_PRODUCTION_PROVIDER_ROUTES_FILE=<ROOT>/deploy/provider-routes.mock.json
AIVERO_PRODUCTION_MEDIA_ROOT=<ROOT>/data/dev/media
SWARMUI_DATA_DIR=<ROOT>/data/dev/media

# 想启用画布助手(需要真实模型凭据,费用自理)时取消注释并填写:
# AIVERO_PRODUCTION_AGENT_ROUTES_FILE=<ROOT>/data/dev/agent-routes.json
# AIVERO_PRODUCTION_AGENT_PERSONAS_FILE=<ROOT>/deploy/agent-personas.default.json

# 本地 Mock Host，运行目录由 dev:stack 生成；部署模板保持禁用。
AIVERO_PRODUCTION_RUNTIME_ENVIRONMENT=development
AIVERO_PRODUCTION_HOST_CATALOG_FILE=<ROOT>/data/dev/host-catalog.json

# 本脚本只启动隔离的本地 Mock 环境
AIVERO_RUNTIME_ENVIRONMENT=development

# 分层意图灰度；顺位依赖 INTENT_RAG，默认均关闭。
INTENT_RAG=false
INTENT_MULTI_STEP=false
INTENT_RAG_SHADOW=false
INTENT_DIRECT_I2V=false
# INTENT_EMBED_MODEL_ID=固定本地模型版本
# INTENT_EMBED_URL=http://127.0.0.1:8091/v1/embeddings
# INTENT_EXEMPLARS=/absolute/path/approved-exemplars.yaml
# INTENT_INDEX=/absolute/path/approved-exemplars.index.json
